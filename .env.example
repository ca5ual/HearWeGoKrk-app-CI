# Copy to .env (never commit .env) and start with:
#   .venv/bin/uvicorn app:app --host 0.0.0.0 --port 8000 --env-file .env

# Agent: "claude" = llm_agent.py (Claude tool calling). Leave empty = rule-based brain.
AGENT=claude
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=low

# ElevenLabs: speech -> text (Scribe) and text -> speech. The key needs both
# "Speech to Text" and "Text to Speech" access. Without it: no voice input, phone voice output.
ELEVENLABS_API_KEY=
# A voice that speaks Polish: ElevenLabs Voice Library -> filter language "Polish" -> copy the voice ID
ELEVENLABS_VOICE_ID=
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_FORMAT=mp3_44100_128
